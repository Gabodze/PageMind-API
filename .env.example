# Server
NODE_ENV=development
PORT=3000

# Database (example only — put real values in .env, not here)
DATABASE_URL=postgresql://pagemind:YOUR_PASSWORD@127.0.0.1:5433/pagemind?schema=public

# JWT (use long random strings in .env)
JWT_ACCESS_SECRET=your-secret-key-at-least-16-characters
JWT_REFRESH_SECRET=your-refresh-secret-at-least-16-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI (OpenAI-compatible, e.g. Groq)
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=your-model-id